    // Enforce strictly 52 heroes and deduplicated valid counter references
    const VALID_HERO_NAMES = new Set(HEROES.map(h => h.name));
    HEROES.forEach(hero => {
      const seen = new Set();
      hero.counters = hero.counters.filter(c => {
        if (!VALID_HERO_NAMES.has(c.hero) || seen.has(c.hero)) return false;
        seen.add(c.hero);
        return true;
      });
    });

    // =========================================================================
    // 3. APPLICATION STATE
    // =========================================================================
    const ROLES = ['All', 'Assassin', 'Fighter', 'Mage', 'Marksman', 'Tank', 'Support'];

    const state = {
      activeTab: 'draft',          // 'draft' | 'emblems'
      enemyCounter: '',          // Enemy hero name to find counters for
      search: '',                // Search query
      role: 'All',               // Role filter pill
      lane: 'All Lanes',         // Lane filter dropdown
      talent: '',                // Tier 3 Core Talent filter dropdown
      selectedHeroId: 'helcurt', // Default selected hero on load
      inspectorTab: 'overview'   // 'overview' | 'combos' | 'build' | 'team'
    };

    // =========================================================================
    // 4. SYMBOL & BADGE HELPERS ("ASSAS" FOR ASSASSIN)
    // =========================================================================
    function formatRoleSymbol(role) {
      return role === 'Assassin' ? 'ASSAS' : role.slice(0, 3).toUpperCase();
    }

    function renderHeroCrest(hero, size = 'md') {
      const meta = ROLE_META[hero.role] || ROLE_META.Fighter;
      const initials = hero.name
        .split(/[\s.-]+/)
        .filter(Boolean)
        .map(part => part[0])
        .join('')
        .slice(0, 2)
        .toUpperCase();
      const dim = size === 'lg' ? 'w-14 h-14 text-lg' : 'w-11 h-11 text-sm';
      const symbol = formatRoleSymbol(hero.role);

      return `
        <div class="${dim} shrink-0 rounded-2xl bg-gradient-to-br ${meta.grad} p-[1.5px] shadow-lg">
          <div class="w-full h-full rounded-[14px] bg-[#060b16]/95 flex flex-col items-center justify-center relative overflow-hidden">
            <span class="font-display font-extrabold text-white tracking-wider leading-none">${initials}</span>
            <span class="text-[9px] font-mono font-bold mt-0.5 leading-none ${meta.badge.split(' ')[1]}">${symbol}</span>
          </div>
        </div>
      `;
    }

    function renderStepChip(stepObj, compact = false) {
      let cls = 'bg-[#22d3ee]/15 text-cyan-200 border-[#22d3ee]/40';
      if (stepObj.type === 'ult') {
        cls = 'bg-[#f5c451]/20 text-amber-200 border-[#f5c451]/60';
      } else if (stepObj.type === 'ba') {
        cls = 'bg-purple-500/20 text-purple-200 border-purple-400/40';
      } else if (stepObj.type === 'spell') {
        cls = 'bg-rose-500/20 text-rose-200 border-rose-400/40';
      }
      const pad = compact ? 'px-1.5 py-0.5 text-[10px]' : 'px-2.5 py-1 text-xs';
      return `<span class="font-mono font-bold rounded-md border ${pad} ${cls}">${escapeHTML(stepObj.label)}</span>`;
    }

    function renderComboChain(steps, compact = false) {
      return steps.map((s, i) => `
        <span class="inline-flex items-center gap-1">
          ${renderStepChip(s, compact)}
          ${i < steps.length - 1 ? '<span class="text-slate-500 text-xs font-bold">→</span>' : ''}
        </span>
      `).join('');
    }

    // =========================================================================
    // 5. INITIALIZATION & FILTER HANDLERS
    // =========================================================================
    function init() {
      populateEnemyDropdown();
      populateTalentDropdown();
      renderRolePills();
      renderEmblemCodex();
      renderHeroes();
      renderInspector(getSelectedHero());

      const searchInput = document.getElementById('search-input');
      searchInput.addEventListener('input', (e) => {
        state.search = e.target.value.trim();
        document.getElementById('clear-search').classList.toggle('hidden', !state.search);
        renderHeroes();
      });
    }

    function populateEnemyDropdown() {
      const select = document.getElementById('enemy-counter-select');
      const sorted = [...HEROES].sort((a, b) => a.name.localeCompare(b.name));
      sorted.forEach(h => {
        const opt = document.createElement('option');
        opt.value = h.name;
        opt.textContent = `⚔ Counter: ${h.name} (${formatRoleSymbol(h.role)})`;
        select.appendChild(opt);
      });
    }

    function populateTalentDropdown() {
      const select = document.getElementById('talent-select');
      const talents = [...new Set(HEROES.map(h => h.emblem.t3))].sort((a, b) => a.localeCompare(b));
      talents.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t;
        opt.textContent = `⚡ Talent: ${t}`;
        select.appendChild(opt);
      });
    }

    function renderRolePills() {
      const container = document.getElementById('role-pills');
      container.innerHTML = ROLES.map(role => {
        const active = state.role === role;
        const meta = ROLE_META[role];
        const symbol = role === 'All' ? '' : `<span class="font-mono text-[10px] mr-0.5">${formatRoleSymbol(role)}</span>`;
        const activeCls = 'bg-[#f5c451]/20 text-amber-200 border-[#f5c451]/70 shadow-sm';
        const inactiveCls = 'bg-[#111c33] text-slate-400 border-[#1e325c] hover:text-slate-200 hover:border-[#22d3ee]/40';
        return `
          <button onclick="setRole('${role}')"
            class="px-3 py-1.5 rounded-xl border text-xs font-semibold transition shrink-0 flex items-center gap-1 ${active ? activeCls : inactiveCls}">
            ${role !== 'All' && meta ? `<span class="${meta.badge.split(' ')[1]}">${symbol}</span>` : ''}
            <span>${role}</span>
          </button>
        `;
      }).join('');
    }

    function setRole(role) {
      state.role = role;
      renderRolePills();
      renderHeroes();
    }

    function handleLaneSelect(lane) {
      state.lane = lane;
      renderHeroes();
    }

    function handleTalentSelect(talent) {
      state.talent = talent;
      renderHeroes();
    }

    function handleEnemySelect(enemyName) {
      state.enemyCounter = enemyName;
      const banner = document.getElementById('counter-banner');

      if (!enemyName) {
        banner.classList.add('hidden');
        renderHeroes();
        return;
      }

      const enemyHero = HEROES.find(h => h.name.toLowerCase() === enemyName.toLowerCase());
      if (enemyHero) {
        document.getElementById('banner-enemy-name').textContent =
          `${enemyHero.name} (${formatRoleSymbol(enemyHero.role)} ${enemyHero.role})`;
        document.getElementById('banner-counter-chips').innerHTML = enemyHero.counters.map(c => `
          <button onclick="jumpToHeroByName('${escapeAttr(c.hero)}')"
            class="px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/40 text-emerald-200 text-xs font-semibold transition">
            ✦ ${escapeHTML(c.hero)}
          </button>
        `).join('');
        banner.classList.remove('hidden');
      }

      renderHeroes();
    }

    function resetEnemyCounter() {
      state.enemyCounter = '';
      document.getElementById('enemy-counter-select').value = '';
      document.getElementById('counter-banner').classList.add('hidden');
      renderHeroes();
    }

    function clearSearch() {
      state.search = '';
      document.getElementById('search-input').value = '';
      document.getElementById('clear-search').classList.add('hidden');
      renderHeroes();
    }

    function resetAllFilters() {
      state.enemyCounter = '';
      state.search = '';
      state.role = 'All';
      state.lane = 'All Lanes';
      state.talent = '';

      document.getElementById('enemy-counter-select').value = '';
      document.getElementById('search-input').value = '';
      document.getElementById('clear-search').classList.add('hidden');
      document.getElementById('lane-select').value = 'All Lanes';
      document.getElementById('talent-select').value = '';
      document.getElementById('counter-banner').classList.add('hidden');

      renderRolePills();
      renderHeroes();
    }

    function applyTalentFilter(talentName) {
      state.talent = talentName;
      document.getElementById('talent-select').value = talentName;
      switchMainTab('draft');
      renderHeroes();
      showToast(`Filtered heroes by talent: ${talentName}`);
    }

    function applyEmblemFilter(emblemName) {
      resetAllFilters();
      state.search = emblemName;
      document.getElementById('search-input').value = emblemName;
      document.getElementById('clear-search').classList.remove('hidden');
      switchMainTab('draft');
      renderHeroes();
      showToast(`Showing heroes using ${emblemName} Emblem`);
    }

    // =========================================================================
    // 6. FILTERING, ROSTER GRID & INSPECTOR
    // =========================================================================
    function getFilteredHeroes() {
      const q = state.search.toLowerCase();
      let counterSet = null;

      if (state.enemyCounter) {
        const enemyObj = HEROES.find(h => h.name.toLowerCase() === state.enemyCounter.toLowerCase());
        if (enemyObj) {
          counterSet = new Set(enemyObj.counters.map(c => c.hero.toLowerCase()));
        }
      }

      return HEROES.filter(hero => {
        if (state.role !== 'All' && hero.role !== state.role) return false;
        if (state.lane !== 'All Lanes' && !hero.lane.includes(state.lane)) return false;
        if (state.talent && hero.emblem.t3.toLowerCase() !== state.talent.toLowerCase()) return false;

        if (counterSet) {
          const matchesCounterList = counterSet.has(hero.name.toLowerCase());
          const matchesCounterReason = hero.counters.some(c => c.hero.toLowerCase() === state.enemyCounter.toLowerCase());
          if (!matchesCounterList && !matchesCounterReason) return false;
        }

        if (q) {
          const haystack = [
            hero.name,
            hero.role,
            hero.specialty,
            ...hero.lane,
            ...hero.strengths,
            ...hero.counters.map(c => `${c.hero} ${c.reason}`),
            hero.emblem.name,
            hero.emblem.t1,
            hero.emblem.t2,
            hero.emblem.t3,
            hero.emblem.spell,
            ...hero.build,
            ...hero.swaps,
            ...hero.combos.map(cb => `${cb.name} ${cb.tip} ${cb.steps.map(s => s.label).join(' ')}`),
            hero.team.archetype,
            hero.team.winCondition
          ].join(' ').toLowerCase();
          if (!haystack.includes(q)) return false;
        }

        return true;
      });
    }

    function renderHeroes() {
      const list = getFilteredHeroes();
      const grid = document.getElementById('hero-grid');
      const empty = document.getElementById('empty-state');
      document.getElementById('visible-count').textContent = list.length;

      if (list.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');

      grid.innerHTML = list.map(hero => {
        const isSelected = hero.id === state.selectedHeroId;
        const meta = ROLE_META[hero.role] || ROLE_META.Fighter;
        const primaryCombo = hero.combos[0];

        return `
          <article onclick="selectHero('${hero.id}')"
            class="animate-card cursor-pointer rounded-2xl p-4 border transition-all duration-200 flex flex-col justify-between
            ${isSelected
              ? 'bg-[#111c33] border-[#f5c451] shadow-gold-glow ring-1 ring-[#f5c451]/40'
              : 'bg-[#0b1326]/95 border-[#1e325c] hover:border-[#22d3ee]/60 hover:bg-[#111c33]/80'}">
            <div>
              <!-- Header -->
              <div class="flex items-start justify-between gap-2.5 mb-2.5">
                <div class="flex items-center gap-2.5 min-w-0">
                  ${renderHeroCrest(hero, 'md')}
                  <div class="min-w-0">
                    <h3 class="font-bold text-white text-base truncate">${escapeHTML(hero.name)}</h3>
                    <p class="text-[11px] text-slate-400 truncate">${escapeHTML(hero.specialty)}</p>
                    <div class="flex flex-wrap items-center gap-1 mt-1">
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md border ${meta.badge}">
                        ${formatRoleSymbol(hero.role)} ${escapeHTML(hero.role)}
                      </span>
                      ${hero.lane.map(l => `
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-[#060b16] border border-[#1e325c] text-slate-300">${escapeHTML(l)}</span>
                      `).join('')}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Emblem & Spell Strip -->
              <div class="flex items-center justify-between gap-2 text-[11px] bg-[#060b16]/80 border border-[#1e325c]/80 rounded-xl px-2.5 py-1.5 mb-2.5">
                <span class="text-[#f5c451] font-semibold truncate">⚡ ${escapeHTML(hero.emblem.name)} · ${escapeHTML(hero.emblem.t3)}</span>
                <span class="text-[#22d3ee] font-mono text-[10px] shrink-0">${escapeHTML(hero.emblem.spell)}</span>
              </div>

              <!-- Top Combo Preview -->
              <div class="bg-[#060b16]/70 border border-[#1e325c]/70 rounded-xl p-2 mb-2.5">
                <div class="text-[10px] font-mono text-cyan-300 uppercase mb-1 truncate">${escapeHTML(primaryCombo.name)}</div>
                <div class="flex flex-wrap items-center gap-1">
                  ${renderComboChain(primaryCombo.steps, true)}
                </div>
              </div>
            </div>

            <!-- Countered By Footer -->
            <div class="pt-2 border-t border-[#1e325c]/70">
              <div class="flex items-center justify-between text-[10px] font-mono uppercase text-rose-300 mb-1">
                <span>Countered By</span>
                <span class="text-[#f5c451]">Inspect →</span>
              </div>
              <div class="flex flex-wrap gap-1">
                ${hero.counters.map(c => `
                  <span class="text-[10px] px-2 py-0.5 rounded bg-rose-500/10 border border-rose-500/30 text-rose-200">${escapeHTML(c.hero)}</span>
                `).join('')}
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function getSelectedHero() {
      return HEROES.find(h => h.id === state.selectedHeroId) || HEROES[0];
    }

    function selectHero(id) {
      state.selectedHeroId = id;
      const hero = getSelectedHero();
      renderHeroes();
      renderInspector(hero);

      if (window.innerWidth < 1280) {
        const modal = document.getElementById('mobile-inspector-modal');
        document.getElementById('mobile-inspector-content').innerHTML = buildInspectorHTML(hero, true);
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeMobileInspector() {
      document.getElementById('mobile-inspector-modal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function setInspectorTab(tab) {
      state.inspectorTab = tab;
      const hero = getSelectedHero();
      renderInspector(hero);
      const modal = document.getElementById('mobile-inspector-modal');
      if (!modal.classList.contains('hidden')) {
        document.getElementById('mobile-inspector-content').innerHTML = buildInspectorHTML(hero, true);
      }
    }

    function jumpToHeroByName(heroName) {
      const target = HEROES.find(h => h.name.toLowerCase() === heroName.toLowerCase());
      if (!target) {
        showToast(`${heroName} is not in the active 52-hero list.`);
        return;
      }
      state.selectedHeroId = target.id;
      renderHeroes();
      renderInspector(target);

      if (window.innerWidth < 1280) {
        document.getElementById('mobile-inspector-content').innerHTML = buildInspectorHTML(target, true);
        document.getElementById('mobile-inspector-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      showToast(`Switched inspector to ${target.name}`);
    }

    function renderInspector(hero) {
      document.getElementById('desktop-inspector').innerHTML = buildInspectorHTML(hero, false);
    }

    function buildInspectorHTML(hero, isMobile) {
      const meta = ROLE_META[hero.role] || ROLE_META.Fighter;
      const subTabs = [
        { id: 'overview', label: 'Overview & Counters' },
        { id: 'combos',   label: 'Skill Combos' },
        { id: 'build',    label: '6-Item Build' },
        { id: 'team',     label: 'Emblem & Team' }
      ];

      let body = '';

      if (state.inspectorTab === 'overview') {
        body = `
          <div class="mb-4">
            <h4 class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold mb-2">✦ Core Strengths</h4>
