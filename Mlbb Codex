              `).join('')}
            </div>
          </div>
        `;
      } else if (state.inspectorTab === 'combos') {
        body = `
          <div class="space-y-3">
            ${hero.combos.map((cb, idx) => `
              <div class="bg-[#060b16] border border-[#1e325c] rounded-2xl p-3.5">
                <div class="text-xs sm:text-sm font-bold text-white mb-2">
                  <span class="text-[#f5c451] font-mono mr-1.5">#${idx + 1}</span>${escapeHTML(cb.name)}
                </div>
                <div class="flex flex-wrap items-center gap-1.5 bg-[#0b1326] border border-[#1e325c]/80 rounded-xl p-2.5 mb-2.5">
                  ${renderComboChain(cb.steps, false)}
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                  <strong class="text-[#22d3ee]">Combo Tip:</strong> ${escapeHTML(cb.tip)}
                </p>
              </div>
            `).join('')}
          </div>
        `;
      } else if (state.inspectorTab === 'build') {
        body = `
          <div class="mb-4">
            <h4 class="text-xs font-mono uppercase tracking-wider text-[#f5c451] font-bold mb-2">Recommended 6-Item Build</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${hero.build.map((item, idx) => `
                <div class="bg-[#060b16] border border-[#1e325c] rounded-xl p-2.5 flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-lg bg-[#f5c451]/15 border border-[#f5c451]/40 text-[#f5c451] font-mono text-xs font-bold flex items-center justify-center shrink-0">
                    ${idx + 1}
                  </span>
                  <span class="text-xs font-semibold text-slate-100 truncate">${escapeHTML(item)}</span>
                </div>
              `).join('')}
            </div>
            <p class="text-xs text-slate-400 mt-2.5 bg-[#060b16]/70 border border-[#1e325c]/70 rounded-xl p-2.5">
              <strong class="text-[#f5c451]">Build Synergy:</strong> Core itemization for ${escapeHTML(hero.name)} (${escapeHTML(hero.specialty)}) paired with ${escapeHTML(hero.emblem.name)} Emblem and ${escapeHTML(hero.emblem.spell)}.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-mono uppercase tracking-wider text-[#22d3ee] font-bold mb-2">Situational Swaps</h4>
            <div class="flex flex-wrap gap-1.5">
              ${hero.swaps.map(sw => `
                <span class="text-xs px-3 py-1.5 rounded-xl bg-[#111c33] border border-[#22d3ee]/35 text-cyan-200 font-medium">
                  ↻ ${escapeHTML(sw)}
                </span>
              `).join('')}
            </div>
          </div>
        `;
      } else if (state.inspectorTab === 'team') {
        const slots = [
          { lane: 'EXP Lane',  val: hero.team.exp },
          { lane: 'Jungle',    val: hero.team.jungle },
          { lane: 'Mid Lane',  val: hero.team.mid },
          { lane: 'Gold Lane', val: hero.team.gold },
          { lane: 'Roam',      val: hero.team.roam }
        ];

        body = `
          <!-- Emblem & Spell -->
          <div class="bg-[#060b16] border border-[#f5c451]/35 rounded-2xl p-3.5 mb-4">
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <span class="text-xs font-mono uppercase text-[#f5c451] font-bold">Emblem &amp; Battle Spell</span>
              <span class="text-xs font-mono text-[#22d3ee] font-bold">Spell: ${escapeHTML(hero.emblem.spell)}</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
              <div class="bg-[#0b1326] border border-[#1e325c] rounded-xl p-2">
                <span class="text-[9px] font-mono uppercase text-slate-400 block">Emblem</span>
                <span class="text-xs font-bold text-white">${escapeHTML(hero.emblem.name)}</span>
              </div>
              <div class="bg-[#0b1326] border border-[#1e325c] rounded-xl p-2">
                <span class="text-[9px] font-mono uppercase text-slate-400 block">Tier 1</span>
                <span class="text-xs font-semibold text-cyan-200">${escapeHTML(hero.emblem.t1)}</span>
              </div>
              <div class="bg-[#0b1326] border border-[#1e325c] rounded-xl p-2">
                <span class="text-[9px] font-mono uppercase text-slate-400 block">Tier 2</span>
                <span class="text-xs font-semibold text-cyan-200">${escapeHTML(hero.emblem.t2)}</span>
              </div>
              <div class="bg-[#f5c451]/15 border border-[#f5c451]/50 rounded-xl p-2">
                <span class="text-[9px] font-mono uppercase text-[#f5c451] block">Tier 3 Core</span>
                <span class="text-xs font-bold text-amber-200">${escapeHTML(hero.emblem.t3)}</span>
              </div>
            </div>
          </div>

          <!-- 5-Lane Dream Team -->
          <div class="bg-[#060b16] border border-[#22d3ee]/35 rounded-2xl p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
              <span class="text-xs font-mono uppercase text-[#22d3ee] font-bold">5-Man Dream Team</span>
              <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#22d3ee]/10 border border-[#22d3ee]/30 text-cyan-200">
                ${escapeHTML(hero.team.archetype)}
              </span>
            </div>

            <div class="space-y-1.5 mb-3">
              ${slots.map(s => {
                const isSelf = s.val.toLowerCase() === hero.name.toLowerCase();
                return `
                  <div onclick="jumpToHeroByName('${escapeAttr(s.val)}')"
                    class="cursor-pointer flex items-center justify-between px-3 py-2 rounded-xl border transition
                    ${isSelf
                      ? 'bg-[#f5c451]/15 border-[#f5c451]/60 text-amber-200'
                      : 'bg-[#0b1326] hover:bg-[#111c33] border-[#1e325c] hover:border-[#22d3ee]/50 text-slate-200'}">
                    <span class="text-[11px] font-mono uppercase ${isSelf ? 'text-[#f5c451] font-bold' : 'text-slate-400'}">${s.lane}</span>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold">${escapeHTML(s.val)}</span>
                      <span class="text-[10px] font-mono ${isSelf ? 'text-[#f5c451]' : 'text-cyan-400'}">${isSelf ? 'SELECTED' : 'Jump →'}</span>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>

            <p class="text-xs text-slate-300 leading-relaxed pt-2 border-t border-[#1e325c]">
              <strong class="text-emerald-400">Win Condition:</strong> ${escapeHTML(hero.team.winCondition)}
            </p>
          </div>
        `;
      }

      return `
        <div class="p-4 sm:p-5 border-b border-[#1e325c] bg-[#0b1326] shrink-0">
          <div class="flex items-start justify-between gap-3 mb-3.5">
            <div class="flex items-center gap-3 min-w-0">
              ${renderHeroCrest(hero, 'lg')}
              <div class="min-w-0">
                <h2 class="font-display text-lg sm:text-xl font-bold text-white truncate">${escapeHTML(hero.name)}</h2>
                <p class="text-xs text-slate-400 truncate">${escapeHTML(hero.specialty)}</p>
                <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md border ${meta.badge}">
                    ${formatRoleSymbol(hero.role)} ${escapeHTML(hero.role)}
                  </span>
                  ${hero.lane.map(l => `
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-[#111c33] border border-[#1e325c] text-slate-300">${escapeHTML(l)}</span>
                  `).join('')}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <button onclick="copyFullGuide('${hero.id}')"
                class="px-3 py-2 rounded-xl bg-[#f5c451]/20 hover:bg-[#f5c451]/30 border border-[#f5c451]/60 text-amber-200 text-xs font-semibold transition flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <span>Copy Full Guide</span>
              </button>
              ${isMobile ? `
                <button onclick="closeMobileInspector()" class="p-2 rounded-xl bg-[#111c33] hover:bg-slate-800 text-slate-300 text-xs font-bold border border-[#1e325c]">
                  ✕
                </button>
              ` : ''}
            </div>
          </div>

          <!-- Inspector Sub-Tabs -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-1 bg-[#060b16] p-1 rounded-xl border border-[#1e325c]">
            ${subTabs.map(t => {
              const active = state.inspectorTab === t.id;
              return `
                <button onclick="setInspectorTab('${t.id}')"
                  class="py-1.5 px-2 rounded-lg text-[11px] font-semibold transition truncate
                  ${active
                    ? 'bg-[#f5c451]/20 text-amber-200 border border-[#f5c451]/60'
                    : 'text-slate-400 hover:text-white'}">
                  ${t.label}
                </button>
              `;
            }).join('')}
          </div>
        </div>

        <div class="p-4 sm:p-5 overflow-y-auto flex-1">
          ${body}
        </div>
      `;
    }

    // =========================================================================
    // 7. EMBLEM CODEX RENDERING
    // =========================================================================
    function renderEmblemCodex() {
      const grid = document.getElementById('emblems-grid');
      grid.innerHTML = Object.values(EMBLEM_CATALOG).map(emb => {
        const count = HEROES.filter(h => h.emblem.name === emb.id).length;
        const sym = formatRoleSymbol(emb.id);
        return `
          <div class="bg-[#0b1326] border border-[#1e325c] hover:border-[#f5c451]/60 rounded-2xl p-5 flex flex-col justify-between transition shadow-lg">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-3 py-1 rounded-lg border text-xs font-bold ${emb.badge}">
                  ${escapeHTML(sym)} ${escapeHTML(emb.name)}
                </span>
                <span class="text-xs font-mono text-slate-400">${count} Heroes</span>
              </div>

              <div class="mb-3">
                <span class="text-[10px] font-mono uppercase text-slate-500 block mb-1">Max Level Base Attributes</span>
                <ul class="space-y-1">
                  ${emb.maxStats.map(stItem => `
                    <li class="text-xs text-emerald-300 font-medium">• ${escapeHTML(stItem)}</li>
                  `).join('')}
                </ul>
              </div>

              <p class="text-xs text-slate-400 mb-3">
                <strong class="text-slate-200">Ideal For:</strong> ${escapeHTML(emb.roleSummary)}
              </p>

              <div class="bg-[#060b16] border border-[#1e325c] rounded-xl p-2.5 mb-4">
                <span class="text-[10px] font-mono uppercase text-[#f5c451] block mb-1">Recommended Talents</span>
                <div class="text-xs text-cyan-200 font-medium">${escapeHTML(emb.recommendedTalents.join(' → '))}</div>
              </div>
            </div>

            <button onclick="applyEmblemFilter('${escapeAttr(emb.id)}')"
              class="w-full py-2 rounded-xl bg-[#f5c451]/15 hover:bg-[#f5c451]/25 border border-[#f5c451]/50 text-amber-200 text-xs font-semibold transition">
              Filter ${count} ${escapeHTML(emb.name)} Heroes →
            </button>
          </div>
        `;
      }).join('');

      const coreGrid = document.getElementById('core-talents-grid');
      coreGrid.innerHTML = TIER3_TALENTS.map(t => `
        <div onclick="applyTalentFilter('${escapeAttr(t.name)}')"
          class="cursor-pointer bg-[#060b16] hover:bg-[#111c33] border border-[#1e325c] hover:border-[#22d3ee]/60 rounded-xl p-3.5 transition">
          <div class="text-xs font-bold text-[#f5c451] mb-1">⚡ ${escapeHTML(t.name)}</div>
          <p class="text-xs text-slate-400 leading-relaxed">${escapeHTML(t.desc)}</p>
        </div>
      `).join('');
    }

    // =========================================================================
    // 8. TAB SWITCHING, CLIPBOARD & UTILITIES
    // =========================================================================
    function switchMainTab(tab) {
      state.activeTab = tab;
      const draftView = document.getElementById('view-draft');
      const emblemsView = document.getElementById('view-emblems');

      const activeCls = ['bg-[#f5c451]/20', 'text-amber-200', 'border', 'border-[#f5c451]/60'];
      const inactiveCls = ['text-slate-400', 'hover:text-white'];

      const dBtn = document.getElementById('tab-draft-desktop');
      const eBtn = document.getElementById('tab-emblems-desktop');
      const dMob = document.getElementById('tab-draft-mobile');
      const eMob = document.getElementById('tab-emblems-mobile');

      if (tab === 'draft') {
        draftView.classList.remove('hidden');
        emblemsView.classList.add('hidden');
        [dBtn, dMob].forEach(el => { el.classList.add(...activeCls); el.classList.remove(...inactiveCls); });
        [eBtn, eMob].forEach(el => { el.classList.remove(...activeCls); el.classList.add(...inactiveCls); });
      } else {
        draftView.classList.add('hidden');
        emblemsView.classList.remove('hidden');
        [eBtn, eMob].forEach(el => { el.classList.add(...activeCls); el.classList.remove(...inactiveCls); });
        [dBtn, dMob].forEach(el => { el.classList.remove(...activeCls); el.classList.add(...inactiveCls); });
      }
    }

    function copyFullGuide(heroId) {
      const hero = HEROES.find(h => h.id === heroId);
      if (!hero) return;

      const lines = [
        `MLBB // ${hero.name.toUpperCase()} (${formatRoleSymbol(hero.role)} ${hero.role} · ${hero.lane.join('/')})`,
        `Emblem: ${hero.emblem.name} [${hero.emblem.t1} | ${hero.emblem.t2} | ${hero.emblem.t3}] · Spell: ${hero.emblem.spell}`,
        `6-Item Build: ${hero.build.join(' -> ')}`,
        `Swaps: ${hero.swaps.join(', ')}`,
        `Combos:`,
        ...hero.combos.map(c => `  - ${c.name}: ${c.steps.map(s => s.label).join(' -> ')} (${c.tip})`),
        `Counters: ${hero.counters.map(c => c.hero).join(', ')}`,
        `5-Man Team (${hero.team.archetype}): EXP ${hero.team.exp} | Jungle ${hero.team.jungle} | Mid ${hero.team.mid} | Gold ${hero.team.gold} | Roam ${hero.team.roam}`
      ];

      const ta = document.createElement('textarea');
      ta.value = lines.join('\n');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast(`Copied full ${hero.name} guide to clipboard!`);
      } catch (err) {
        showToast('Copy failed in this browser context.');
      }
      document.body.removeChild(ta);
    }

    let toastTimer;
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-3');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-3');
      }, 2600);
    }

    function escapeHTML(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeAttr(str) {
      return String(str).replace(/'/g, "\\'");
    }

    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
